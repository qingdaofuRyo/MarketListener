{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/strategy-definition.schema.json",
  "title": "Versioned executable Strategy definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "display_name", "origin", "supported_asset_types", "status", "base_timeframe", "universe", "parameters", "entry_rules", "exit_rules", "position_sizing", "stop_loss", "take_profit", "pyramiding", "reentry", "risk", "execution", "backtest", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128},
    "version": {"type": "integer", "minimum": 1},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "maxLength": 4000},
    "template_source": {
      "type": "object", "additionalProperties": false,
      "required": ["template_id", "template_version", "source_strategy_id", "source_strategy_version", "default_overrides"],
      "properties": {
        "template_id": {"type": "string", "pattern": "^template\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "template_version": {"type": "integer", "minimum": 1},
        "source_strategy_id": {"type": ["string", "null"]},
        "source_strategy_version": {"type": ["integer", "null"], "minimum": 1},
        "default_overrides": {"type": "object", "additionalProperties": true}
      }
    },
    "origin": {"enum": ["builtin", "custom", "community", "plugin"]},
    "trust_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["publisher", "trust_state", "review_status"],
      "properties": {
        "publisher": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "display_name"],
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 128},
            "display_name": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "signature": {
          "type": ["object", "null"], "additionalProperties": false,
          "properties": {
            "algorithm": {"enum": ["ed25519"]},
            "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "verified": {"type": "boolean"}
          },
          "required": ["algorithm", "key_id", "verified"]
        },
        "trust_state": {"enum": ["untrusted", "trusted", "rejected"]},
        "review_status": {"enum": ["pending", "approved", "rejected"]}
      }
    },
    "supported_asset_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["STOCK", "B_SHARE", "INDEX", "FUTURE", "OPTION", "FUND", "ETF", "LOF", "REIT", "BOND", "CONVERTIBLE_BOND", "COMMODITY"]}},
    "status": {"enum": ["draft", "active", "deprecated", "disabled"]},
    "base_timeframe": {"type": "string", "enum": ["1m", "5m", "15m", "30m", "1h", "2h", "4h", "1d", "1w", "1mo", "3mo", "6mo", "1y"]},
    "universe": {"type": "object", "additionalProperties": false, "properties": {"instrument_ids": {"type": "array", "uniqueItems": true, "maxItems": 1000, "items": {"type": "string"}}, "market_types": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "exclude_st": {"type": "boolean"}}, "anyOf": [{"required": ["instrument_ids"]}, {"required": ["market_types"]}]},
    "parameters": {"type": "object", "maxProperties": 100, "additionalProperties": {"$ref": "#/$defs/parameter"}},
    "entry_rules": {"$ref": "#/$defs/rule"},
    "exit_rules": {"$ref": "#/$defs/rule"},
    "direction": {"enum": ["long", "short"]},
    "position_sizing": {"$ref": "#/$defs/positionSizing"},
    "stop_loss": {"$ref": "#/$defs/exitControl"},
    "take_profit": {"$ref": "#/$defs/exitControl"},
    "scale_out": {"type": "object", "additionalProperties": false, "required": ["enabled", "ratio_percent"], "properties": {"enabled": {"type": "boolean"}, "ratio_percent": {"type": "number", "minimum": 1, "maximum": 99}}},
    "pyramiding": {"type": "object", "additionalProperties": false, "required": ["enabled", "max_entries"], "properties": {"enabled": {"type": "boolean"}, "max_entries": {"type": "integer", "minimum": 1, "maximum": 20}}},
    "reentry": {"type": "object", "additionalProperties": false, "required": ["enabled", "cooldown_bars"], "properties": {"enabled": {"type": "boolean"}, "cooldown_bars": {"type": "integer", "minimum": 0, "maximum": 10000}}},
    "risk": {"type": "object", "additionalProperties": false, "required": ["max_position_percent", "max_drawdown_percent"], "properties": {"max_position_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "max_drawdown_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["run_mode", "signal_timing", "fill_price"], "properties": {"run_mode": {"enum": ["backtest", "paper", "live"]}, "signal_timing": {"const": "bar_close"}, "fill_price": {"enum": ["next_open", "next_close"]}}},
    "backtest": {"type": "object", "additionalProperties": false, "required": ["initial_cash", "commission_rate", "slippage_rate"], "properties": {"initial_cash": {"type": "number", "exclusiveMinimum": 0}, "commission_rate": {"type": "number", "minimum": 0, "maximum": 1}, "slippage_rate": {"type": "number", "minimum": 0, "maximum": 1}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "parameter": {"type": "object", "additionalProperties": false, "required": ["type", "default"], "properties": {"type": {"enum": ["integer", "number", "boolean", "string"]}, "default": {}, "minimum": {"type": "number"}, "maximum": {"type": "number"}}},
    "operand": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "field"], "properties": {"kind": {"const": "series"}, "field": {"enum": ["open", "high", "low", "close", "volume", "amount", "open_interest", "settlement"]}, "offset": {"type": "integer", "minimum": 0, "maximum": 10000}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "literal"}, "value": {"type": ["number", "boolean", "string"]}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"const": "parameter"}, "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "call"], "properties": {"kind": {"const": "function"}, "call": {"$ref": "#/$defs/functionCall"}}}
    ]},
    "functionCall": {"type": "object", "additionalProperties": false, "required": ["function_id", "version", "arguments"], "properties": {"function_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}, "version": {"type": "integer", "minimum": 1}, "arguments": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/operand"}}}},
    "condition": {"type": "object", "additionalProperties": false, "required": ["node_type", "left"], "properties": {"node_type": {"const": "condition"}, "left": {"$ref": "#/$defs/functionCall"}, "comparator": {"enum": ["gte", "lte", "gt", "eq", "lt", "ne"]}, "right": {"$ref": "#/$defs/operand"}}, "allOf": [{"if": {"required": ["comparator"]}, "then": {"required": ["right"]}}]},
    "group": {"type": "object", "additionalProperties": false, "required": ["node_type", "operator", "children"], "properties": {"node_type": {"const": "group"}, "operator": {"enum": ["AND", "OR", "NOT"]}, "children": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/rule"}}}, "allOf": [{"if": {"properties": {"operator": {"const": "NOT"}}, "required": ["operator"]}, "then": {"properties": {"children": {"maxItems": 1}}}}]},
    "rule": {"oneOf": [{"$ref": "#/$defs/condition"}, {"$ref": "#/$defs/group"}]},
    "positionSizing": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["fixed_quantity", "equity_percent", "risk_percent"]}, "value": {"type": "number", "exclusiveMinimum": 0}}},
    "exitControl": {"type": "object", "additionalProperties": false, "required": ["enabled", "kind", "value"], "properties": {"enabled": {"type": "boolean"}, "kind": {"enum": ["percent", "atr_multiple", "fixed_price"]}, "value": {"type": "number", "minimum": 0}}}
  },
  "allOf": [
    {
      "if": {"properties": {"origin": {"enum": ["community", "plugin"]}}, "required": ["origin"]},
      "then": {
        "required": ["trust_metadata"],
        "properties": {"status": {"const": "disabled"}}
      }
    }
  ]
}
