{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/bar.schema.json",
  "title": "Normalized market bar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instrument_key", "period", "trading_day", "bar_open_time", "bar_close_time", "timezone", "open", "high", "low", "close", "volume", "amount", "open_interest", "price_mode", "source", "source_period", "quality_status"],
  "properties": {
    "schema_version": {"const": 1},
    "instrument_key": {"$ref": "#/$defs/instrumentKey"},
    "period": {"enum": ["1m", "5m", "15m", "30m", "1h", "2h", "4h", "1d", "1w", "1mo"]},
    "trading_day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "bar_open_time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "bar_close_time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "timezone": {"type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z_]+(?:/[A-Za-z_]+)*$"},
    "open": {"type": "number", "exclusiveMinimum": 0},
    "high": {"type": "number", "exclusiveMinimum": 0},
    "low": {"type": "number", "exclusiveMinimum": 0},
    "close": {"type": "number", "exclusiveMinimum": 0},
    "pct_change": {"type": ["number", "null"], "description": "close 相对前一根 bar close 的涨跌幅，派生字段"},
    "amplitude": {"type": ["number", "null"], "description": "(high-low)/前一根 close，派生字段"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "description": "计价货币，例如 CNY/HKD/USD"},
    "volume": {"type": "number", "minimum": 0},
    "amount": {"type": "number", "minimum": 0},
    "open_interest": {"type": ["number", "null"], "minimum": 0},
    "raw_open": {"type": ["number", "null"], "description": "来源文件中的原始开盘值"},
    "raw_high": {"type": ["number", "null"], "description": "来源文件中的原始最高值"},
    "raw_low": {"type": ["number", "null"], "description": "来源文件中的原始最低值"},
    "raw_close": {"type": ["number", "null"], "description": "来源文件中的原始收盘值"},
    "raw_volume": {"type": ["number", "null"], "minimum": 0},
    "raw_amount": {"type": ["number", "null"], "minimum": 0},
    "price_scale": {"type": "number", "exclusiveMinimum": 0},
    "volume_multiplier": {"type": "number", "exclusiveMinimum": 0},
    "volume_unit": {"enum": ["SHARE", "BOND_UNIT", "TDX_INDEX_RAW", "REPO_LOT_1000_CNY"]},
    "normalization_method": {"type": "string", "minLength": 1},
    "normalization_status": {"enum": ["PASS", "FAILED"]},
    "normalization_version": {"type": "string", "minLength": 1},
    "price_mode": {"enum": ["RAW", "FORWARD_ADJUSTED", "BACKWARD_ADJUSTED"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_symbol", "retrieved_at"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "source_symbol": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    },
    "source_period": {"type": "string", "minLength": 1},
    "quality_status": {"enum": ["PASS", "WARNING", "FAILED"]}
  },
  "$defs": {
    "instrumentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_or_market", "exchange", "asset_type", "code"],
      "properties": {
        "country_or_market": {"type": "string", "pattern": "^[A-Z]{2,12}$"},
        "exchange": {"type": "string", "pattern": "^[A-Z0-9_-]{2,16}$"},
        "asset_type": {"enum": ["STOCK", "B_SHARE", "INDEX", "FUTURE", "OPTION", "FUND", "ETF", "LOF", "REIT", "BOND", "CONVERTIBLE_BOND", "EXCHANGEABLE_BOND", "PLEDGED_REPO", "REPO", "COMMODITY", "CRYPTO"]},
        "code": {"type": "string", "pattern": "^[A-Z0-9._-]+$"}
      }
    }
  }
}
