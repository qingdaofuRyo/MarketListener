{
  "schemaVersion": 1,
  "formulaVersion": "2026-08-v1",
  "lookbackTradingDays": 10,
  "timeWeight": {
    "method": "exponential_decay",
    "halfLifeTradingDays": 3
  },
  "defaultUserWeight": {
    "breadthWeight": 0.4,
    "fundWeight": 0.6
  },
  "userWeight": {
    "min": 0.0,
    "max": 1.0,
    "step": 0.05
  },
  "score": {
    "min": -100.0,
    "max": 100.0
  },
  "stateBands": [
    { "min": -100.0, "max": -80.0, "label": "极度偏空" },
    { "min": -80.0, "max": -60.0, "label": "明显偏空" },
    { "min": -60.0, "max": -20.0, "label": "偏空" },
    { "min": -20.0, "max": 20.0, "label": "多空均衡" },
    { "min": 20.0, "max": 60.0, "label": "偏多" },
    { "min": 60.0, "max": 80.0, "label": "明显偏多" },
    { "min": 80.0, "max": 100.0, "label": "极度偏多" }
  ],
  "fundUnit": "元",
  "neutralThreshold": 0.0,
  "divergenceThreshold": 10.0,
  "minFundCoverage": 0.8,
  "excludeExchanges": [
    "CFFEX"
  ]
}
