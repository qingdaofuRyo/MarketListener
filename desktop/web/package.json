{
  "name": "marketlistener-research-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "lint:ui": "eslint src/design src/components/terminal src/components/charts/QuoteValues.vue vite.config.ts playwright.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test e2e/market-layout-r4-s4.spec.ts e2e/chart-workbench-r4.spec.ts e2e/ui-r5-baseline.spec.ts --workers=1",
    "verify:ui": "npm run lint:ui && npm run typecheck && vite build",
    "test": "npm run verify:ui"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "element-plus": "2.14.4",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.11.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.1",
    "vue-tsc": "3.3.9"
  }
}
